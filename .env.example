# MISTRAL Defense — Client Environment Configuration
# Copy this file to .env and fill in your real values
# ═════════════════════════════════════════════════════════════════════════════

# ── Server Connection ────────────────────────────────────────────────────────
SERVER_HOST=localhost
SERVER_WSS_PORT=8443
SERVER_API_PORT=8080
WSS_SECRET_TOKEN=must_match_server_token

# ── Client Dashboard ─────────────────────────────────────────────────────────
CLIENT_PORT=3001

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Client Auth ──────────────────────────────────────────────────────────────
CLIENT_LOGIN=operator
CLIENT_PASSWORD=mistral2025

# ── Node environment ───────────────────────────────────────────────────────
NODE_ENV=production
